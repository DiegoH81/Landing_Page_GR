---
interface Props
{
    titulo: string;
    descripcion: string;
    imagen: string;
}

const { titulo, descripcion, imagen } = Astro.props;
---

<div class="bg-white rounded-3xl overflow-hidden shadow-xl shadow-stone-200/50 border border-stone-100 grid md:grid-cols-2 gap-6 items-center p-4">
    <div class="h-60 md:h-full rounded-2xl overflow-hidden bg-stone-100">
        <img src={imagen} alt={titulo} class="w-full h-full object-cover" loading="lazy" />
    </div>
    <div class="p-4 flex flex-col justify-between h-full">
        <div>
            <h3 class="text-2xl font-black text-stone-900">{titulo}</h3>
            <p class="text-stone-600 mt-3 leading-relaxed text-sm md:text-base">{descripcion}</p>
        </div>
        
        <div class="mt-6">
            <span>Contacto</span> Cotizar Evento
        </div>
    </div>
</div>