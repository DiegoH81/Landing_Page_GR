---
import ActionButton from './ActionButton.astro';

interface Props
{
  titulo: string;
  descripcion: string;
  imagen: string;
  textoBoton?: string;
  enlaceBoton?: string;
  reversed?: boolean;
}

const { 
  titulo, 
  descripcion, 
  imagen, 
  textoBoton = "COTIZAR EVENTO", 
  enlaceBoton = "#",
  reversed = false 
} = Astro.props;
---

<section class="max-w-6xl mx-auto px-4 py-16">
    <div class="relative border p-6 sm:p-8">
        
        <div class={`relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center ${reversed ? 'lg:flex-row-reverse' : ''}`}>
        
        <div class={`lg:col-span-7 ${reversed ? 'lg:order-2' : 'lg:order-1'}`}>
            <div class="relative overflow-hidden shadow-2xl rounded-sm">
            <img 
                src={imagen} 
                alt={titulo} 
                class="w-full h-[350px] sm:h-[450px] object-cover hover:scale-105 transition-transform duration-500"
                loading="lazy" 
            />
            </div>
        </div>

        <div class={`lg:col-span-5 ${reversed ? 'lg:order-1' : 'lg:order-2'} bg-stone-50 lg:bg-transparent p-6 sm:p-8 lg:p-0 rounded-lg`}>
            <div class="space-y-4">

            <h3 class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight leading-tight">
                {titulo}
            </h3>

            <p class="text-stone-600 leading-relaxed text-base font-normal">
                {descripcion}
            </p>




            <ActionButton href={enlaceBoton}>
                    {textoBoton}
            </ActionButton>    
            
            </div>
        </div>

        </div>
    </div>
</section>