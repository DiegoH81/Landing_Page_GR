---
interface Props
{
    nombre: string;
    precio: string;
    imagen: string;
}

const { nombre, precio, imagen } = Astro.props;
---

<div class="bg-white rounded-3xl overflow-hidden shadow-xl shadow-stone-200/50 border border-stone-100 flex flex-col h-full group">
    <div class="relative overflow-hidden h-48 bg-stone-100">
        <img 
            src={imagen} 
            alt={nombre} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
        />
    </div>

    <!-- Contenido -->
    <div class="p-6 flex flex-col justify-between flex-grow">
        <div>
            <h3 class="text-xl font-bold text-stone-900 group-hover:text-orange-600 transition-colors">
                {nombre}
            </h3>
        </div>
        <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between">
            <span class="text-sm text-stone-500 font-medium">Precio</span>
            <span class="text-2xl font-black text-orange-600">{precio}</span>
        </div>
    </div>
</div>