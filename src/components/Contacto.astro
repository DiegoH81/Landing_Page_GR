---
interface Props
{
  direccion?: string;
  ciudad?: string;
  telefonoFijo?: string;
  celular?: string;
  horarioAtencion?: string;
  mapaEmbedUrl?: string;
}

const {
  direccion = "Avenida Villa Hermosa 807, Cerro Colorado",
  ciudad = "AREQUIPA – PERÚ",
  telefonoFijo = "054 259778",
  celular = "961 662 599",
  horarioAtencion = "12:00 am. a 4:30 pm.",
  mapaEmbedUrl = "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d1914.0187040010692!2d-71.5610892!3d-16.3720567!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91424a1aaf017bf3%3A0x6fbb09081ecce80d!2sLa%20Gran%20Reserva!5e0!3m2!1ses!2spe!4v1785040074163!5m2!1ses!2spe"
} = Astro.props;
---

<section class="max-w-6xl mx-auto px-4 py-16">
  <div class="text-center mb-12 space-y-2">
    <div class="flex items-center justify-center gap-3 text-brand-red">
      <h2 class="text-4xl font-black text-brand-red tracking-wider uppercase">
        Contacto
      </h2>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-5 space-y-6 text-brand-brown font-normal">
      
      <div class="space-y-1">
        <p class="text-lg font-medium text-brand-brown-700">{direccion}</p>
        <p class="text-sm tracking-wider uppercase font-semibold text-brand-brown-500">{ciudad}</p>
      </div>

      <hr class="border-brand-brown" />

      <div class="space-y-1 text-sm sm:text-base">
        <p><span class="font-medium text-brand-brown-700">T.</span> {telefonoFijo}</p>
        <p><span class="font-medium text-brand-brown-700">C.</span> {celular}</p>
      </div>

      <div class="pt-2 space-y-2">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-brown-400">
          Horario de Repartos y Atención en Salón
        </p>
        <p class="font-bold text-brand-brown-800 tracking-wide text-sm">
          DE LUNES A DOMINGO, EXCEPTO MARTES
        </p>
        
        <hr class="border-brand-brown-300 my-2" />

        <ul class="space-y-1 text-sm text-brand-brown-600 pt-1">
          <li><strong class="font-medium text-brand-brown-800">Recojo en Local:</strong> {horarioAtencion}</li>
          <li><strong class="font-medium text-brand-brown-800">Delivery:</strong> 054 27778 - 961662500 </li>
        </ul>
      </div>

    </div>

    <div class="lg:col-span-7">
      <div class="w-full h-[380px] sm:h-[420px] rounded-sm overflow-hidden shadow-md border border-stone-200">
        <iframe
          src={mapaEmbedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>

  </div>
</section>