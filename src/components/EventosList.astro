---
import Evento from '../components/EventoCard.astro';

import primer_piso_new from '../assets/eventos/primer_piso_new.webp';
import primer_piso_old from '../assets/eventos/primer_piso_old.webp';
import segundo_piso_old from '../assets/eventos/segundo_piso_old.webp';
import segundo_piso_s from '../assets/eventos/segundo_piso_s.webp';
---

<section class="flex flex-col items-center justify-between pt-16 md:pt-24 mb-16" id="eventos">
    
    <div class="text-center max-w-2xl px-4 mb-12 md:mb-16">
        <h2 class="text-3xl md:text-5xl font-black text-brand-red tracking-tight mb-4">
            Eventos
        </h2>
        <p class="text-base md:text-lg text-gray-600 font-normal leading-relaxed">
            Celebra tus grandes momentos con nosotros. Contamos con espacios diseñados para hacer de cada ocasión una experiencia inolvidable.
        </p>
    </div>

    <div class="w-full space-y-12 md:space-y-12">
        <Evento
            titulo="Salón Arequipa"
            descripcion="Un ambiente amplio y moderno ubicado en el primer piso. Cuenta con un diseño de techos elevados, acabados contemporáneos en tonos cálidos y una amplia iluminación natural"
            imagen={primer_piso_new}
            textoBoton="PEDIR INFORMACIÓN"
        />

        <Evento
            titulo="Salón Tradición"
            descripcion="Ubicado en el primer piso, es un espacio de gran extensión que destaca por sus columnas centrales, piso claro e iluminación uniforme en toda la sala"
            imagen={primer_piso_old}
            textoBoton="PEDIR INFORMACIÓN"
            reversed={true}
        />

        <Evento
            titulo="Salón Mirador"
            descripcion="Ubicado en el segundo piso, es un espacio de gran capacidad rodeado de amplios ventanales. Destaca por su iluminación perimetral y una vista despejada hacia el exterior"
            imagen={segundo_piso_old}
            textoBoton="PEDIR INFORMACIÓN"
        />

        <Evento
            titulo="Salón Familiar"
            descripcion="Un ambiente más reservado y acogedor situado en el segundo piso. Presenta un diseño continuo con ventilación e iluminación natural a lo largo de su fachada acristalada"
            imagen={segundo_piso_s}
            textoBoton="PEDIR INFORMACIÓN"
            reversed={true}
        />
    </div>

</section>