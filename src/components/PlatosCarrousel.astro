---
import PlatoCard from '../components/PlatoCard.astro';
import rocoto from '../assets/platos_tipicos/ROCOTO.webp';
import chaque from '../assets/platos_tipicos/chaque.webp';
import chicharron from '../assets/platos_tipicos/chicharron.webp';
import pescado from '../assets/platos_tipicos/pescado.webp';
import cordon_bleu from '../assets/platos_tipicos/c_bleu.webp';
import res from '../assets/platos_tipicos/chuleta_res.webp';


const platos = [
    {
        nombre: "Entradas",
        imagen: rocoto
    },
    {
        nombre: "Platos típicos",
        imagen: chicharron
    },
    {
        nombre: "Sopas",
        imagen: chaque
    },
    {
        nombre: "Pollos",
        imagen: cordon_bleu
    },
    {
        nombre: "Pescados",
        imagen: pescado
    },
    {
        nombre: "Parrilla",
        imagen: res
    }
];
---

<section class="py-16 bg-brand-cream overflow-hidden" id="platos">
    <div class="max-w-6xl mx-auto px-4">
        
        <div class="flex flex-row items-center justify-between mb-8">
            <div>
                <h2 class="text-3xl md:text-5xl font-black text-brand-red">
                    Platos típicos y comida peruana
                </h2>
            </div>

            <div class="flex items-center gap-3">
                <button 
                    id="prevBtn" 
                    type="button"
                    aria-label="Anterior"
                    class="p-3 bg-brand-cream border border-brand-red/20 text-brand-red hover:bg-brand-red hover:text-white transition-colors duration-200 shadow-sm cursor-pointer select-none"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                    </svg>
                </button>
                <button 
                    id="nextBtn" 
                    type="button"
                    aria-label="Siguiente"
                    class="p-3 bg-brand-cream border border-brand-red/20 text-brand-red hover:bg-brand-red hover:text-white transition-colors duration-200 shadow-sm cursor-pointer select-none"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="overflow-hidden w-full py-4">
            <div 
                id="carouselContainer" 
                class="flex gap-6 w-max select-none"
            >
                {platos.map((plato) => (
                    <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] carousel-item">
                        <PlatoCard nombre={plato.nombre} imagen={plato.imagen} />
                    </div>
                ))}
            </div>
        </div>

    </div>
</section>

<script>
    const container = document.getElementById('carouselContainer') as HTMLDivElement;
    const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
    const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;

    if (container && prevBtn && nextBtn)
    {
        const getStep = () => {
            const item = container.querySelector('.carousel-item') as HTMLDivElement;
            return (item?.offsetWidth || 320) + 24; // 24px = gap-6
        };

        const finalizePendingAnimation = (direction: 'next' | 'prev') => {
            container.style.transition = 'none';
            if (direction === 'next' && container.firstElementChild) {
                container.appendChild(container.firstElementChild);
            } else if (direction === 'prev' && container.lastElementChild) {
                container.prepend(container.lastElementChild);
            }
            container.style.transform = 'translateX(0px)';
            void container.offsetHeight;
        };

        let currentDirection: 'next' | 'prev' | null = null;
        let isAnimating = false;

        const onTransitionEnd = () => {
            if (!isAnimating) return;
            container.style.transition = 'none';
            
            if (currentDirection === 'next' && container.firstElementChild) {
                container.appendChild(container.firstElementChild);
            }
            
            container.style.transform = 'translateX(0px)';
            isAnimating = false;
            currentDirection = null;
        };

        container.addEventListener('transitionend', onTransitionEnd);

        nextBtn.addEventListener('click', () => {
            const step = getStep();

            if (isAnimating)
                finalizePendingAnimation(currentDirection || 'next');

            isAnimating = true;
            currentDirection = 'next';

            requestAnimationFrame(() => {
                container.style.transition = 'transform 200ms cubic-bezier(0.2, 0, 0, 1)';
                container.style.transform = `translateX(-${step}px)`;
            });
        });

        prevBtn.addEventListener('click', () => {
            const step = getStep();

            if (isAnimating)
                finalizePendingAnimation(currentDirection || 'prev');

            isAnimating = true;
            currentDirection = 'prev';

            if (container.lastElementChild)
                container.prepend(container.lastElementChild);
            
            container.style.transition = 'none';
            container.style.transform = `translateX(-${step}px)`;
            void container.offsetHeight;

            requestAnimationFrame(() => {
                container.style.transition = 'transform 200ms cubic-bezier(0.2, 0, 0, 1)';
                container.style.transform = 'translateX(0px)';
            });
        });
    }
</script>