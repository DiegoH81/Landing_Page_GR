---
import "../styles/global.css"

import Hero from "../components/Hero.astro"
import Plato from "../components/PlatoCard.astro"
import Evento from "../components/EventoCard.astro"
import type { $brand } from "astro:schema"
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<Hero />
		<Plato 
        nombre="Zapatillas Air Max" 
        precio="S/.120.00" 
        imagen="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500" 
      	/>

		<Evento
		titulo = "Titulo"
		descripcion = "Prueba desc"
		imagen = "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500"
		/>
	</body>
</html>
